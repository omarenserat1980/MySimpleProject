+bool CConnectManager::readCtrlData(u8*data, u32 len) {
+	if(NULL==ctrlSocket || NULL==ctrlSocket->iSocket) {
+		CCarLifeLog::carLifeLogLnWithPrefix("ctrlSocket is null!");
+		return false;
+	}
+
+	if(!ctrlSocket->iSocket->recv(data, len)) {
+		ctrlSocket->setConnectStatus(false);
+		CCarLifeLog::carLifeLogLnWithPrefix("ctrl socket.recv is failed!");
+		return false;
+	}
+
+	return true;
