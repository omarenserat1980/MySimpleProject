[Unit]
Description=Electronic Brain Arkan Software-Only Executor
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/MySimpleProject
Environment=BRAIN_ARKAN_SOFTWARE_ROOT=%h/.brain/runtime/arkan-software-node
ExecStart=/usr/bin/python3 -m brain_v12.brain.arkan_software_executor serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.brain/runtime/arkan-software-node

[Install]
WantedBy=default.target
