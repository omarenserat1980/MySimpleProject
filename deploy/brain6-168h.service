[Unit]
Description=Electronic Brain 6 - 168 Hour Autonomous Campaign
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/MySimpleProject
ExecStart=%h/MySimpleProject/scripts/brain6_168h.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
