# Public HTTPS origin of the Brain Cloud API.
BRAIN_ORIGIN=https://brain.example.com

# Optional public UI origin(s).
BRAIN_API_ORIGIN=https://brain.example.com

# Runtime identity.
BRAIN_CLOUD_MODE=1
BRAIN_INTERNAL_RUNNER_FLAG=1

# Persistent runtime configuration.
BRAIN_RUNTIME_ROOT=/var/lib/brain/runtime
BRAIN_WORKER_POLL_SECONDS=2
BRAIN_TASK_TIMEOUT=3600

# Configure secrets only in the cloud secret manager/environment.
# Never commit real credentials.
