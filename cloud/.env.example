FACTORY_ALLOW_PRODUCTION=1
FACTORY_REQUIRE_REAL_MEDIA=1
FACTORY_ALLOW_YOUTUBE_PUBLISH=0
FACTORY_INTERVAL_SECONDS=21600
BRAIN_SLEEP_SECONDS=60
# Supply provider secrets only in the cloud secret manager/environment.
OPENAI_API_KEY=
FAL_KEY=
GITHUB_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
MEDIA_RENDER_URL=
MEDIA_RENDER_API_KEY=

BRAIN_FAILURE_BACKOFF_SECONDS=60
BRAIN_MAX_BACKOFF_SECONDS=1800
BRAIN_MAX_RESPONSE_BYTES=2000000
BRAIN_MAX_REDIRECTS=5
BRAIN_USER_AGENT=ElectronicBrain/1.0

BRAIN_GOALS=build_ai_products,improve_video_factory,improve_self
BRAIN_GOAL_EXECUTE=1
BRAIN_SOFTWARE_FACTORY_TIMEOUT=300
BRAIN_BLOCK_PRIVATE_NETWORKS=1
BRAIN_STATE_DIR=/app/.brain_state
# Required for the authenticated control plane; store the real value in the secret manager.
BRAIN_CONTROL_TOKEN=
